{
  "name": "near-paymandate-web",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:sandbox": "node --test tests/sandbox.integration.mjs",
    "test:wasm": "node --test tests/wasm.integration.mjs",
    "test:browser": "node --test tests/browser.smoke.mjs",
    "test:runtime": "node --test tests/runtime.integration.mjs",
    "test:coverage": "node --experimental-strip-types --experimental-test-coverage --test-coverage-include=src/lib/*.ts --test tests/*.test.ts"
  },
  "dependencies": {
    "@hot-labs/near-connect": "0.12.0",
    "near-api-js": "7.4.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7",
    "@fontsource/instrument-sans": "5.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24",
    "@types/react": "19",
    "@types/react-dom": "19",
    "near-sandbox": "0.3.5",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "playwright-core": "1.65.0"
  },
  "type": "module",
  "overrides": {
    "near-sandbox": {
      "tar": "7.5.22"
    }
  }
}
